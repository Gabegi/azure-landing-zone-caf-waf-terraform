{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-assignment-schema.json",
  "nodeName": "/security/",
  "children": [
    {
      "nodeName": "landingzones/",
      "scope": {
        "tenant01": [
          "/providers/Microsoft.Management/managementGroups/contoso-workloads"
        ]
      },
      "assignment": {
        "name": "lz-security-baseline",
        "displayName": "Landing Zones — Security baseline",
        "description": "Network hardening, encryption, and PaaS access controls for landing zone subscriptions"
      },
      "definitionEntry": {
        "policySetName": "contoso-security"
      },
      "enforcementMode": "Default"
    },
    {
      "nodeName": "platform/",
      "scope": {
        "tenant01": [
          "/providers/Microsoft.Management/managementGroups/contoso-platform"
        ]
      },
      "assignment": {
        "name": "platform-security-baseline",
        "displayName": "Platform — Security baseline",
        "description": "Network hardening, encryption, and PaaS access controls for platform subscriptions"
      },
      "definitionEntry": {
        "policySetName": "contoso-security"
      },
      "enforcementMode": "Default"
    }
  ]
}
