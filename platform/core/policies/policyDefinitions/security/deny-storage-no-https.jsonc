{
  "name": "contoso-deny-storage-no-https",
  "properties": {
    "displayName": "Deny — Storage accounts without HTTPS",
    "description": "Denies storage accounts that do not enforce HTTPS-only traffic.",
    "mode": "Indexed",
    "metadata": { "version": "1.0.0", "category": "Storage" },
    "parameters": {},
    "policyRule": {
      "if": {
        "allOf": [
          { "field": "type", "equals": "Microsoft.Storage/storageAccounts" },
          { "field": "Microsoft.Storage/storageAccounts/supportsHttpsTrafficOnly", "equals": false }
        ]
      },
      "then": { "effect": "Deny" }
    }
  }
}
